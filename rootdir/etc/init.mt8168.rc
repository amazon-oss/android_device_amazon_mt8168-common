import /vendor/etc/init/hw/init.mt8168.usb.rc

on early-init
    # Performance
    mount debugfs debugfs /sys/kernel/debug
    chmod 0755 /sys/kernel/debug

    # Preloader
    write /sys/block/mmcblk0boot0/ro_lock_until_next_power_on 1

on init
    # ION
    chmod 0666 /dev/ion

    # Network
    write /proc/sys/net/core/rmem_max 8388608
    write /proc/sys/net/core/wmem_max 8388608

    # TEE
    symlink /dev/block/platform/bootdevice/by-name/dkb /dev/dkb
    symlink /dev/block/platform/bootdevice/by-name/kb /dev/kb

on early-fs
    # ZRAM
    write /sys/block/zram0/comp_algorithm lz4

on fs
    # Partitions
    symlink /dev/block/platform/soc/11230000.mmc /dev/block/platform/bootdevice
    mkdir /mnt/vendor/nvcfg
    mount_all /vendor/etc/fstab.mt8168

    # ZRAM
    write /proc/sys/vm/page-cluster 0
    swapon_all /vendor/etc/fstab.enableswap

on post-fs-data
    # Bluetooth
    mkdir /data/vendor/bluetooth 0770 bluetooth bluetooth
    start vendor.btmac

    # Display
    chmod 0666 /dev/mali0
    chmod 0444 /dev/m4u
    chmod 0640 /proc/m4u
    chown system media /proc/m4u
    chmod 0640 /dev/mtk_cmdq
    chown system system /dev/mtk_cmdq
    chmod 0640 /dev/mdp_sync
    chown system system /dev/mdp_sync
    chmod 0660 /dev/graphics/fb0
    chown system graphics /dev/graphics/fb0
    chmod 0660 /dev/mtk_disp_mgr
    chown system graphics /dev/mtk_disp_mgr
    chmod 0660 /dev/mtkfb_vsync
    chown system graphics /dev/mtkfb_vsync
    chmod 0660 /dev/sw_sync
    chown system graphics /dev/sw_sync
    chmod 0660 /dev/mt-mdp
    chown system media /dev/mt-mdp
    chmod 0660 /dev/MTK_SMI
    chown media media /dev/MTK_SMI
    chmod 0660 /dev/mtk_rrc
    chown system media /dev/mtk_rrc

    # DRM
    chown system system /proc/secmem0

    # Encryption
    setprop vold.post_fs_data_done 1

    # Fuel gauge
    chown system system /mnt/vendor/nvcfg/fg
    chown system system /mnt/vendor/nvcfg/fg/car_tune_value
    chown system system /mnt/vendor/nvcfg/fg/old_fg_data

    # Media
    chmod 0660 /dev/vcu
    chown media system /dev/vcu
    chmod 0660 /dev/video0
    chown media system /dev/video0
    chmod 0660 /dev/video1
    chown media system /dev/video1
    mkdir /data/vendor/vcodec 0770 media system
    mkdir /data/vendor/vcodec/in 0770 media system
    mkdir /data/vendor/vcodec/log 0770 media system
    mkdir /data/vendor/vcodec/out 0770 media system
    chmod 0664 /sys/bus/platform/drivers/emi_ctrl/concurrency_scenario
    chown media media /sys/bus/platform/drivers/emi_ctrl/concurrency_scenario

    # NVCFG
    chown system system /mnt/vendor/nvcfg
    chmod 0771 /mnt/vendor/nvcfg
    restorecon_recursive /mnt/vendor/nvcfg

    # NVRAM
    mkdir /mnt/vendor/nvdata 0771 root system
    mkdir /mnt/vendor/nvdata/media 0771 media audio
    restorecon_recursive /mnt/vendor/nvdata

    # Thermal
    mkdir /data/vendor/.tp 0775 system system

on early-boot
    # Wi-Fi
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi

on boot
    # Connsys
    insmod /vendor/lib/modules/mt8168_common.ko

    # Display
    chown system system /sys/class/leds/lcd-backlight/brightness
    chmod 0664 /sys/class/leds/lcd-backlight/brightness

    # Performance
    write /proc/sys/vm/dirty_writeback_centisecs 300
    chmod 0660 /sys/power/autosleep

    # Touchscreen
    chown system system /sys/touchscreen/link_input_dev/gesture_wakeup
    chmod 0660 /sys/touchscreen/link_input_dev/gesture_wakeup

    stop console

on property:sys.boot_completed=1
    # Power
    write /sys/devices/system/cpu/eas/enable 2
    write /proc/sys/kernel/sched_migration_cost_ns 200000
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor schedutil
    write /proc/perfmgr/boost_ctrl/dram_ctrl/ddr 2

on property:vendor.connsys.driver.ready=yes
    # Bluetooth
    insmod /vendor/lib/modules/mt8168_bt.ko

    # Wi-Fi
    insmod /vendor/lib/modules/mt8168_wlan_adaptor.ko
    insmod /vendor/lib/modules/mt8168_wlan.ko
    wait /dev/wmtWifi
    write /dev/wmtWifi "C"

service vendor.btmac /vendor/bin/init.btmac.sh
    user bluetooth
    group bluetooth
    disabled
    oneshot

service vendor.media.omx /vendor/bin/hw/android.hardware.media.omx@1.0-service
    override
    class late_start
    user mediacodec
    group camera drmrpc mediadrm media_rw sdcard_rw media system audio inet net_bt net_bt_admin net_bw_acct sdcard_r
    ioprio rt 4
    writepid /dev/cpuset/foreground/tasks

service wmt_launcher /vendor/bin/wmt_launcher -p /vendor/firmware/ -o 1
    class core
    user system
    group system

service wmt_loader /vendor/bin/wmt_loader
    class core
    user system
    group system
    oneshot
