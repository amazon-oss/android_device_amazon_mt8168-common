on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "11201000.usb"
    setprop sys.usb.ffs.aio_compat 1
    write /sys/block/mmcblk0boot0/force_ro 1
    write /sys/block/mmcblk0boot1/force_ro 1
