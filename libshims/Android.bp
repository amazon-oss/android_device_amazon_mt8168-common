cc_library_shared {
    name: "libmtkcam_grallocutils",
    srcs: ["libmtkcam_grallocutils/GrallocHelper.cpp"],
    export_include_dirs: ["libmtkcam_grallocutils/include"],
    header_libs: ["libhardware_headers"],
    shared_libs: [
        "libcutils",
        "libhidlbase",
        "liblog",
        "libui",
        "libutils",
    ],
    compile_multilib: "32",
    vendor: true,
}
